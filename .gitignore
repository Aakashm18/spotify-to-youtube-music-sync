# ── Python cache & bytecode ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/

# ── Distribution / build artefacts ───────────────────────────────────────────
*.egg-info/
dist/
build/
*.egg

# ── Logs produced by the sync scripts ────────────────────────────────────────
logs/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Secrets / credentials  ────────────────────────────────────────────────────
# Never commit OAuth tokens or client secrets!
client_secret*.json
token*.json
credentials.json

# ── pytest cache ──────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
